generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  whatsappAccounts WhatsAppAccount[]
  contacts         Contact[]
  conversations    Conversation[]
  aiSettings       AiSettings?

  @@map("organizations")
}

model AiSettings {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  agentName      String   @default("Assistant") @map("agent_name")
  businessInfo   String?  @map("business_info")
  systemPrompt   String   @map("system_prompt")
  welcomeMessage String?  @map("welcome_message")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("ai_settings")
}

enum UserRole {
  ADMIN
  AGENT
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           UserRole @default(ADMIN)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sessions     Session[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  email        String
  organizationId String?  @map("organization_id")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("sessions")
}

enum WhatsAppAccountStatus {
  DISCONNECTED
  QR_PENDING
  CONNECTED
}

model WhatsAppAccount {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  phoneNumber    String?               @map("phone_number")
  status         WhatsAppAccountStatus @default(DISCONNECTED)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("whatsapp_accounts")
}

model Contact {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  whatsappJid    String   @map("whatsapp_jid")
  displayName    String?  @map("display_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  conversations Conversation[]

  @@unique([organizationId, whatsappJid])
  @@index([organizationId])
  @@map("contacts")
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model Conversation {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  contactId      String             @map("contact_id")
  aiEnabled      Boolean            @default(true) @map("ai_enabled")
  status         ConversationStatus @default(OPEN)
  summary        String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])
  messages     Message[]
  aiRuns       AiRun[]

  @@index([organizationId])
  @@index([contactId])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthor {
  CONTACT
  AI
  HUMAN
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  STICKER
  OTHER
}

model AiRun {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  provider       String
  model          String
  latencyMs      Int      @map("latency_ms")
  rawResponse    String   @map("raw_response")
  isValid        Boolean  @map("is_valid")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("ai_runs")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  author         MessageAuthor
  type           MessageType      @default(TEXT)
  content        String
  externalId     String?          @map("external_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([externalId])
  @@index([conversationId])
  @@map("messages")
}