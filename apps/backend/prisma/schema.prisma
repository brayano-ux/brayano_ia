generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                    User[]
  whatsappAccounts         WhatsAppAccount[]
  contacts                 Contact[]
  ignoredContacts          IgnoredContact[]
  conversations            Conversation[]
  aiSettings               AiSettings?
  locations                Location[]
  responsibleAgents        Responsible[]
  routingSettings          OrganizationRoutingSettings?
  prospectLeads            ProspectLead[]
  products                 Product[]
  appointmentSettings      AppointmentSettings?
  appointments             Appointment[]
  orderSettings            OrderSettings?
  orders                   Order[]
  aiCorrections            AiCorrection[]
  broadcasts               Broadcast[]
  billingPayments          BillingPayment[]
  billingSubscription      BillingSubscription?
  freeAiResponsesRemaining Int                          @default(0) @map("free_ai_responses_remaining")
  trialUpgradeEmailSentAt  DateTime?                    @map("trial_upgrade_email_sent_at")
  quotaNoticeAt            DateTime?                    @map("quota_notice_at")
  platformSuspended        Boolean                      @default(false) @map("platform_suspended")
  suspensionReason         String?                      @map("suspension_reason")
  suspendedAt              DateTime?                    @map("suspended_at")
  whatsappNumber           String?                      @map("whatsapp_number")

  @@map("organizations")
}

model AiSettings {
  id                   String   @id @default(uuid())
  organizationId       String   @unique @map("organization_id")
  agentName            String   @default("Assistant") @map("agent_name")
  businessInfo         String?  @map("business_info")
  onboardingTestHash   String?  @map("onboarding_test_hash")
  agentImageUrl        String?  @map("agent_image_url")
  systemPrompt         String   @map("system_prompt")
  welcomeMessage       String?  @map("welcome_message")
  qualificationFields  Json?    @map("qualification_fields")
  aiEnabled            Boolean  @default(true) @map("ai_enabled")
  responseDelaySeconds Int      @default(3) @map("response_delay_seconds")
  businessHoursEnabled Boolean  @default(false) @map("business_hours_enabled")
  businessHours        Json?    @map("business_hours")
  businessTimezone     String   @default("Africa/Douala") @map("business_timezone")
  closedMessage        String?  @map("closed_message")
  followUpEnabled      Boolean  @default(false) @map("follow_up_enabled")
  followUpDelayHours   Int      @default(24) @map("follow_up_delay_hours")
  followUpMax          Int      @default(1) @map("follow_up_max")
  agentDomain          String?  @map("agent_domain")
  agentRole            String?  @map("agent_role")
  agentTone            String?  @map("agent_tone")
  personaPromptedAt    DateTime? @map("persona_prompted_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("ai_settings")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String
  category       String?
  price          String?
  imageUrl       String?  @map("image_url")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  image        ProductImage?

  @@index([organizationId, active])
  @@map("products")
}

/// Copie de la photo d'un produit dans la base : si le disque du serveur est vidé (redéploiement sans disque
/// persistant), la photo est reconstituée depuis cette table au lieu d'être perdue.
model ProductImage {
  productId      String   @id @map("product_id")
  organizationId String   @map("organization_id")
  mimeType       String   @map("mime_type")
  data           Bytes
  updatedAt      DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

enum BillingPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BillingSubscriptionStatus {
  ACTIVE
  INACTIVE
}

model BillingPayment {
  id                String               @id @default(uuid())
  organizationId    String               @map("organization_id")
  providerReference String?              @unique @map("provider_reference")
  externalReference String               @unique @map("external_reference")
  email             String
  phone             String
  plan              String
  amount            Int
  currency          String
  status            BillingPaymentStatus @default(PENDING)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("billing_payments")
}

model BillingSubscription {
  id              String                    @id @default(uuid())
  organizationId  String                    @unique @map("organization_id")
  plan            String
  messageLimit    Int                       @map("message_limit")
  messagesUsed    Int                       @default(0) @map("messages_used")
  periodStartedAt DateTime                  @default(now()) @map("period_started_at")
  status          BillingSubscriptionStatus @default(ACTIVE)
  startedAt       DateTime                  @default(now()) @map("started_at")
  expiresAt       DateTime                  @map("expires_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_subscriptions")
}

enum UserRole {
  ADMIN
  AGENT
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           UserRole @default(ADMIN)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sessions     Session[]

  @@index([organizationId])
  @@map("users")
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("allowed_emails")
}

model SignupVerification {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  companyName    String    @map("company_name")
  whatsappNumber String?   @map("whatsapp_number")
  passwordHash   String    @map("password_hash")
  codeHash       String    @map("code_hash")
  expiresAt      DateTime  @map("expires_at")
  lastSentAt     DateTime  @map("last_sent_at")
  attempts       Int       @default(0)
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("signup_verifications")
}

model PasswordResetVerification {
  id         String   @id @default(uuid())
  email      String   @unique
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  lastSentAt DateTime @map("last_sent_at")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("password_reset_verifications")
}

model Session {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  tokenHash      String    @unique @map("token_hash")
  email          String
  organizationId String?   @map("organization_id")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("sessions")
}

enum WhatsAppAccountStatus {
  DISCONNECTED
  QR_PENDING
  CONNECTED
}

model WhatsAppAccount {
  id                   String                @id @default(uuid())
  organizationId       String                @map("organization_id")
  phoneNumber          String?               @map("phone_number")
  status               WhatsAppAccountStatus @default(DISCONNECTED)
  lastConnectedAt      DateTime?             @map("last_connected_at")
  lastDisconnectedAt   DateTime?             @map("last_disconnected_at")
  lastDisconnectReason String?               @map("last_disconnect_reason")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("whatsapp_accounts")
}

model Contact {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  whatsappJid    String    @map("whatsapp_jid")
  displayName    String?   @map("display_name")
  optedOut       Boolean   @default(false) @map("opted_out")
  optedOutAt     DateTime? @map("opted_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id])
  conversations       Conversation[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([organizationId, whatsappJid])
  @@index([organizationId])
  @@map("contacts")
}

/** Numéros auxquels l'IA ne doit jamais répondre automatiquement (famille, fournisseurs…). Le propriétaire garde la main pour répondre lui-même. */
model IgnoredContact {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  whatsappNumber String   @map("whatsapp_number")
  label          String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, whatsappNumber])
  @@index([organizationId])
  @@map("ignored_contacts")
}

enum ConversationStatus {
  OPEN
  HUMAN_HANDOFF
  CLOSED
}

enum ConversationStage {
  NEW
  INTERESTED
  ORDERED
  CALLBACK
}

enum QualificationStatus {
  NOT_QUALIFIED
  QUALIFYING
  QUALIFIED
}

model Conversation {
  id                  String              @id @default(uuid())
  organizationId      String              @map("organization_id")
  contactId           String              @map("contact_id")
  aiEnabled           Boolean             @default(true) @map("ai_enabled")
  status              ConversationStatus  @default(OPEN)
  qualificationStatus QualificationStatus @default(NOT_QUALIFIED) @map("qualification_status")
  leadScore           Int?                @map("lead_score")
  leadData            Json?               @map("lead_data")
  summary             String?
  stage               ConversationStage   @default(NEW)
  stageLocked         Boolean             @default(false) @map("stage_locked")
  paymentCheckPending Boolean             @default(false) @map("payment_check_pending")
  lastInboundAt       DateTime?           @map("last_inbound_at")
  lastReadAt          DateTime?           @map("last_read_at")
  followUpCount       Int                 @default(0) @map("follow_up_count")
  lastFollowUpAt      DateTime?           @map("last_follow_up_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  contact       Contact        @relation(fields: [contactId], references: [id])
  messages      Message[]
  aiRuns        AiRun[]
  prospectLeads ProspectLead[]

  @@index([organizationId])
  @@index([contactId])
  @@index([organizationId, stage])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthor {
  CONTACT
  AI
  HUMAN
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  STICKER
  OTHER
}

model AiRun {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  provider       String
  model          String
  latencyMs      Int      @map("latency_ms")
  rawResponse    String   @map("raw_response")
  isValid        Boolean  @map("is_valid")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("ai_runs")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  author         MessageAuthor
  type           MessageType      @default(TEXT)
  content        String
  externalId     String?          @map("external_id")
  mediaFile      String?          @map("media_file")
  mediaMimeType  String?          @map("media_mime_type")
  mediaName      String?          @map("media_name")
  aiMeta         Json?            @map("ai_meta")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([externalId])
  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Location {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  name              String
  city              String
  recipientWhatsApp String?  @map("recipient_whatsapp")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id])
  responsible  Responsible[]
  leads        ProspectLead[]

  @@index([organizationId])
  @@index([organizationId, city])
  @@map("locations")
}

model Responsible {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  locationId     String   @map("location_id")
  name           String
  whatsappNumber String   @map("whatsapp_number")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization                  @relation(fields: [organizationId], references: [id])
  location         Location                      @relation(fields: [locationId], references: [id])
  leads            ProspectLead[]
  fallbackSettings OrganizationRoutingSettings[] @relation("FallbackResponsible")

  @@index([organizationId])
  @@index([locationId])
  @@map("responsibles")
}

model OrganizationRoutingSettings {
  id                    String   @id @default(uuid())
  organizationId        String   @unique @map("organization_id")
  fallbackResponsibleId String?  @map("fallback_responsible_id")
  fallbackWhatsApp      String?  @map("fallback_whatsapp")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization        Organization @relation(fields: [organizationId], references: [id])
  fallbackResponsible Responsible? @relation("FallbackResponsible", fields: [fallbackResponsibleId], references: [id])

  @@map("organization_routing_settings")
}

enum ProspectLeadStatus {
  NEW
  QUALIFYING
  QUALIFIED
  ROUTED
  CONTACTED
  CONVERTED
  LOST
}

enum ProspectConsentStatus {
  UNKNOWN
  GRANTED
  REFUSED
}

enum ProspectRoutingStatus {
  PENDING
  SENT
  FAILED
}

model ProspectLead {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  conversationId String?               @map("conversation_id")
  locationId     String?               @map("location_id")
  responsibleId  String?               @map("responsible_id")
  contactName    String?               @map("contact_name")
  whatsappNumber String                @map("whatsapp_number")
  city           String?
  need           String?
  budget         String?
  product        String?
  urgency        String?
  status         ProspectLeadStatus    @default(NEW)
  consentStatus  ProspectConsentStatus @default(UNKNOWN) @map("consent_status")
  routeStatus    ProspectRoutingStatus @default(PENDING) @map("route_status")
  routedAt       DateTime?             @map("routed_at")
  isRouted       Boolean               @default(false) @map("is_routed")
  leadScore      Int                   @default(0) @map("lead_score")
  leadData       Json?                 @map("lead_data")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])
  responsible  Responsible?  @relation(fields: [responsibleId], references: [id])

  @@index([organizationId])
  @@index([whatsappNumber])
  @@index([organizationId, status])
  @@map("prospect_leads")
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  DONE
  NO_SHOW
}

enum AppointmentSource {
  AI
  HUMAN
}

model AppointmentSettings {
  id               String   @id @default(uuid())
  organizationId   String   @unique @map("organization_id")
  enabled          Boolean  @default(false)
  timezone         String   @default("Africa/Douala")
  slotMinutes      Int      @default(30) @map("slot_minutes")
  bufferMinutes    Int      @default(0) @map("buffer_minutes")
  capacity         Int      @default(1)
  minNoticeMinutes Int      @default(60) @map("min_notice_minutes")
  horizonDays      Int      @default(30) @map("horizon_days")
  workingHours     Json     @map("working_hours")
  closedDates      Json?    @map("closed_dates")
  serviceLabel     String?  @map("service_label")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("appointment_settings")
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  conversationId String?           @map("conversation_id")
  contactName    String?           @map("contact_name")
  contactPhone   String?           @map("contact_phone")
  contactJid     String?           @map("contact_jid")
  service        String?
  notes          String?
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  status         AppointmentStatus @default(BOOKED)
  source         AppointmentSource @default(AI)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startsAt])
  @@index([organizationId, contactJid, status])
  @@map("appointments")
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderStatus {
  NEW
  CONFIRMED
  DELIVERED
  CANCELLED
}

model OrderSettings {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("order_settings")
}

model Order {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  conversationId  String?           @map("conversation_id")
  contactJid      String?           @map("contact_jid")
  customerName    String            @map("customer_name")
  customerPhone   String?           @map("customer_phone")
  deliveryAddress String            @map("delivery_address")
  notes           String?
  items           Json
  total           Int?
  status          OrderStatus       @default(NEW)
  paymentStatus   PaymentStatus     @default(UNPAID) @map("payment_status")
  paymentMethod   String?           @map("payment_method")
  paymentNote     String?           @map("payment_note")
  paidAt          DateTime?         @map("paid_at")
  source          AppointmentSource @default(AI)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, contactJid])
  @@map("orders")
}

/// Correction du propriétaire : « dans ce cas, réponds comme ça ». Injectée dans le prompt de CETTE entreprise seulement.
model AiCorrection {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  question       String
  wrongReply     String?  @map("wrong_reply")
  correctReply   String   @map("correct_reply")
  active         Boolean  @default(true)
  usedCount      Int      @default(0) @map("used_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
  @@map("ai_corrections")
}

enum BroadcastStatus {
  SENDING
  DONE
  CANCELLED
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Broadcast {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  text           String
  status         BroadcastStatus @default(SENDING)
  total          Int             @default(0)
  sentCount      Int             @default(0) @map("sent_count")
  failedCount    Int             @default(0) @map("failed_count")
  createdAt      DateTime        @default(now()) @map("created_at")
  finishedAt     DateTime?       @map("finished_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients   BroadcastRecipient[]

  @@index([organizationId, createdAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id          String                   @id @default(uuid())
  broadcastId String                   @map("broadcast_id")
  contactId   String                   @map("contact_id")
  jid         String
  status      BroadcastRecipientStatus @default(PENDING)
  error       String?
  sentAt      DateTime?                @map("sent_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}

/// Compteur de visites de la page d'accueil, sans donnée personnelle : pas d'IP ni de cookie conservés.
/// `visitorHash` est une empreinte à sens unique (HMAC quotidien) qui sert uniquement à estimer le nombre
/// de visiteurs distincts dans la même journée ; elle change chaque jour et ne permet pas de retrouver qui que ce soit.
model LandingPageView {
  id          String   @id @default(uuid())
  day         String   @map("day")
  visitorHash String   @map("visitor_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([day])
  @@index([day, visitorHash])
  @@map("landing_page_views")
}
