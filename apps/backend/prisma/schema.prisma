generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users             User[]
  whatsappAccounts  WhatsAppAccount[]
  contacts          Contact[]
  conversations     Conversation[]
  aiSettings        AiSettings?
  locations         Location[]
  responsibleAgents Responsible[]
  routingSettings   OrganizationRoutingSettings?
  prospectLeads     ProspectLead[]
  products          Product[]
  appointmentSettings AppointmentSettings?
  appointments      Appointment[]
  orderSettings     OrderSettings?
  orders            Order[]
  billingPayments   BillingPayment[]
  billingSubscription BillingSubscription?
  freeAiResponsesRemaining Int @default(0) @map("free_ai_responses_remaining")
  trialUpgradeEmailSentAt DateTime? @map("trial_upgrade_email_sent_at")
  platformSuspended       Boolean   @default(false) @map("platform_suspended")
  suspensionReason        String?   @map("suspension_reason")
  suspendedAt             DateTime? @map("suspended_at")

  @@map("organizations")
}

model AiSettings {
  id                   String   @id @default(uuid())
  organizationId       String   @unique @map("organization_id")
  agentName            String   @default("Assistant") @map("agent_name")
  businessInfo         String?  @map("business_info")
  agentImageUrl        String?  @map("agent_image_url")
  systemPrompt         String   @map("system_prompt")
  welcomeMessage       String?  @map("welcome_message")
  qualificationFields  Json?    @map("qualification_fields")
  aiEnabled            Boolean  @default(true) @map("ai_enabled")
  responseDelaySeconds Int      @default(3) @map("response_delay_seconds")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("ai_settings")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String
  category       String?
  price          String?
  imageUrl       String?  @map("image_url")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
  @@map("products")
}

enum BillingPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BillingSubscriptionStatus {
  ACTIVE
  INACTIVE
}

model BillingPayment {
  id                String               @id @default(uuid())
  organizationId    String               @map("organization_id")
  providerReference String?              @unique @map("provider_reference")
  externalReference String               @unique @map("external_reference")
  email             String
  phone             String
  plan              String
  amount            Int
  currency          String
  status            BillingPaymentStatus @default(PENDING)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("billing_payments")
}

model BillingSubscription {
  id             String                    @id @default(uuid())
  organizationId String                    @unique @map("organization_id")
  plan           String
  messageLimit   Int                       @map("message_limit")
  messagesUsed   Int                       @default(0) @map("messages_used")
  periodStartedAt DateTime                 @default(now()) @map("period_started_at")
  status         BillingSubscriptionStatus @default(ACTIVE)
  startedAt      DateTime                  @default(now()) @map("started_at")
  expiresAt      DateTime                  @map("expires_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_subscriptions")
}

enum UserRole {
  ADMIN
  AGENT
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  role           UserRole @default(ADMIN)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sessions     Session[]

  @@index([organizationId])
  @@map("users")
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("allowed_emails")
}

model SignupVerification {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  companyName  String    @map("company_name")
  passwordHash String    @map("password_hash")
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  lastSentAt   DateTime  @map("last_sent_at")
  attempts     Int       @default(0)
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("signup_verifications")
}

model PasswordResetVerification {
  id         String   @id @default(uuid())
  email      String   @unique
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  lastSentAt DateTime @map("last_sent_at")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("password_reset_verifications")
}

model Session {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  tokenHash      String    @unique @map("token_hash")
  email          String
  organizationId String?   @map("organization_id")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("sessions")
}

enum WhatsAppAccountStatus {
  DISCONNECTED
  QR_PENDING
  CONNECTED
}

model WhatsAppAccount {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  phoneNumber    String?               @map("phone_number")
  status         WhatsAppAccountStatus @default(DISCONNECTED)
  lastConnectedAt      DateTime?       @map("last_connected_at")
  lastDisconnectedAt   DateTime?       @map("last_disconnected_at")
  lastDisconnectReason String?         @map("last_disconnect_reason")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("whatsapp_accounts")
}

model Contact {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  whatsappJid    String   @map("whatsapp_jid")
  displayName    String?  @map("display_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  conversations Conversation[]

  @@unique([organizationId, whatsappJid])
  @@index([organizationId])
  @@map("contacts")
}

enum ConversationStatus {
  OPEN
  HUMAN_HANDOFF
  CLOSED
}

enum QualificationStatus {
  NOT_QUALIFIED
  QUALIFYING
  QUALIFIED
}

model Conversation {
  id                  String              @id @default(uuid())
  organizationId      String              @map("organization_id")
  contactId           String              @map("contact_id")
  aiEnabled           Boolean             @default(true) @map("ai_enabled")
  status              ConversationStatus  @default(OPEN)
  qualificationStatus QualificationStatus @default(NOT_QUALIFIED) @map("qualification_status")
  leadScore           Int?                @map("lead_score")
  leadData            Json?               @map("lead_data")
  summary             String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  contact       Contact        @relation(fields: [contactId], references: [id])
  messages      Message[]
  aiRuns        AiRun[]
  prospectLeads ProspectLead[]

  @@index([organizationId])
  @@index([contactId])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthor {
  CONTACT
  AI
  HUMAN
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  STICKER
  OTHER
}

model AiRun {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  provider       String
  model          String
  latencyMs      Int      @map("latency_ms")
  rawResponse    String   @map("raw_response")
  isValid        Boolean  @map("is_valid")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("ai_runs")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  author         MessageAuthor
  type           MessageType      @default(TEXT)
  content        String
  externalId     String?          @map("external_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([externalId])
  @@index([conversationId])
  @@map("messages")
}

model Location {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  name              String
  city              String
  recipientWhatsApp String?  @map("recipient_whatsapp")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id])
  responsible  Responsible[]
  leads        ProspectLead[]

  @@index([organizationId])
  @@index([organizationId, city])
  @@map("locations")
}

model Responsible {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  locationId     String   @map("location_id")
  name           String
  whatsappNumber String   @map("whatsapp_number")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization                  @relation(fields: [organizationId], references: [id])
  location         Location                      @relation(fields: [locationId], references: [id])
  leads            ProspectLead[]
  fallbackSettings OrganizationRoutingSettings[] @relation("FallbackResponsible")

  @@index([organizationId])
  @@index([locationId])
  @@map("responsibles")
}

model OrganizationRoutingSettings {
  id                    String   @id @default(uuid())
  organizationId        String   @unique @map("organization_id")
  fallbackResponsibleId String?  @map("fallback_responsible_id")
  fallbackWhatsApp      String?  @map("fallback_whatsapp")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization        Organization @relation(fields: [organizationId], references: [id])
  fallbackResponsible Responsible? @relation("FallbackResponsible", fields: [fallbackResponsibleId], references: [id])

  @@map("organization_routing_settings")
}

enum ProspectLeadStatus {
  NEW
  QUALIFYING
  QUALIFIED
  ROUTED
  CONTACTED
  CONVERTED
  LOST
}

enum ProspectConsentStatus {
  UNKNOWN
  GRANTED
  REFUSED
}

enum ProspectRoutingStatus {
  PENDING
  SENT
  FAILED
}

model ProspectLead {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  conversationId String?               @map("conversation_id")
  locationId     String?               @map("location_id")
  responsibleId  String?               @map("responsible_id")
  contactName    String?               @map("contact_name")
  whatsappNumber String                @map("whatsapp_number")
  city           String?
  need           String?
  budget         String?
  product        String?
  urgency        String?
  status         ProspectLeadStatus    @default(NEW)
  consentStatus  ProspectConsentStatus @default(UNKNOWN) @map("consent_status")
  routeStatus    ProspectRoutingStatus @default(PENDING) @map("route_status")
  routedAt       DateTime?             @map("routed_at")
  isRouted       Boolean               @default(false) @map("is_routed")
  leadScore      Int                   @default(0) @map("lead_score")
  leadData       Json?                 @map("lead_data")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  location     Location?     @relation(fields: [locationId], references: [id])
  responsible  Responsible?  @relation(fields: [responsibleId], references: [id])

  @@index([organizationId])
  @@index([whatsappNumber])
  @@index([organizationId, status])
  @@map("prospect_leads")
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  DONE
  NO_SHOW
}

enum AppointmentSource {
  AI
  HUMAN
}

model AppointmentSettings {
  id                  String   @id @default(uuid())
  organizationId      String   @unique @map("organization_id")
  enabled             Boolean  @default(false)
  timezone            String   @default("Africa/Douala")
  slotMinutes         Int      @default(30) @map("slot_minutes")
  bufferMinutes       Int      @default(0) @map("buffer_minutes")
  capacity            Int      @default(1)
  minNoticeMinutes    Int      @default(60) @map("min_notice_minutes")
  horizonDays         Int      @default(30) @map("horizon_days")
  workingHours        Json     @map("working_hours")
  closedDates         Json?    @map("closed_dates")
  serviceLabel        String?  @map("service_label")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("appointment_settings")
}

model Appointment {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  conversationId String?           @map("conversation_id")
  contactName    String?           @map("contact_name")
  contactPhone   String?           @map("contact_phone")
  contactJid     String?           @map("contact_jid")
  service        String?
  notes          String?
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  status         AppointmentStatus @default(BOOKED)
  source         AppointmentSource @default(AI)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startsAt])
  @@index([organizationId, contactJid, status])
  @@map("appointments")
}

enum OrderStatus {
  NEW
  CONFIRMED
  DELIVERED
  CANCELLED
}

model OrderSettings {
  id             String   @id @default(uuid())
  organizationId String   @unique @map("organization_id")
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("order_settings")
}

model Order {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  conversationId  String?           @map("conversation_id")
  contactJid      String?           @map("contact_jid")
  customerName    String            @map("customer_name")
  customerPhone   String?           @map("customer_phone")
  deliveryAddress String            @map("delivery_address")
  notes           String?
  items           Json
  total           Int?
  status          OrderStatus       @default(NEW)
  source          AppointmentSource @default(AI)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, contactJid])
  @@map("orders")
}
