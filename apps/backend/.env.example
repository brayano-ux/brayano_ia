NODE_ENV=development
PORT=3000

DATABASE_URL=your_database_url_here

# Paiement des forfaits : chariow (production), campay (ancien, démo) ou manual.
PAYMENT_PROVIDER=chariow
# Chariow : clé API (sk_test_... / sk_live_...) et secret de signature des Pulses (whsec_...), depuis le tableau de bord Chariow.
# Le Pulse « successful.sale » doit pointer vers APP_URL/billing/chariow/pulse.
CHARIOW_API_KEY=
CHARIOW_PULSE_SECRET=
# Adresse publique du tableau de bord client : retour après paiement et lien dans les emails de forfait.
CLIENT_DASHBOARD_URL=http://localhost:4173/app/
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=your_campay_application_username
CAMPAY_PASSWORD=your_campay_application_password
CAMPAY_CURRENCY=XAF
CAMPAY_DEMO_AMOUNT=25
# Optional override; defaults to APP_URL/billing/campay/callback.
CAMPAY_CALLBACK_URL=
BILLING_PAGE_URL=http://localhost:4173/billing.html
SUPPORT_EMAIL=support@example.com
# "true" = les forfaits sont appliqués (essai de 100 messages, puis forfait payant ; c'est le réglage de production).
# "false" = tout est ouvert, les messages sont seulement comptés (pratique en développement).
BILLING_ENFORCED=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com

LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Secours automatiques : tous les fournisseurs dont la clé est renseignée sont essayés après LLM_PROVIDER
# (avec une seconde tentative sur quota ou panne passagère). Renseigner au moins deux clés en production.
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-small-latest
# OpenRouter : secours de Gemini, ou fournisseur principal avec LLM_PROVIDER=openrouter.
# Le modèle de transcription est indépendant du modèle de conversation.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1

APP_URL=http://localhost:3000

WHATSAPP_AUTH_DIR=./wa-session
# Facultatif. Vide en production : les photos suivent le disque des sessions WhatsApp (WHATSAPP_AUTH_DIR).
# PRODUCT_IMAGE_DIR=./uploads/products

# Obligatoire en production (16 caractères minimum) : signe les liens temporaires des photos de produits et des fichiers reçus.
# OBLIGATOIRE : une longue valeur aléatoire (ex. générée avec `openssl rand -hex 32`), unique à votre installation.
MEDIA_SIGNING_SECRET=
# Nombre de proxys de l'hébergeur devant le serveur (Render : 1). Sert à lire la vraie adresse du client pour limiter les tentatives.
TRUST_PROXY_HOPS=1

# Facultatif. Photos et documents envoyés par les clients (par défaut à côté de WHATSAPP_AUTH_DIR) et durée de conservation en jours (90 par défaut).
# CLIENT_MEDIA_DIR=./uploads/client-media
# CLIENT_MEDIA_RETENTION_DAYS=90

# Relances automatiques, reprise des messages groupés, nettoyage : mettre false pour les couper.
# BACKGROUND_JOBS=true

